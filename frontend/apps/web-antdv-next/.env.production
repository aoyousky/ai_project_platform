VITE_BASE=/

# 接口地址：nginx 把 /prod-api 转发到后端 8080（deploy/nginx/default.conf）
VITE_GLOB_API_URL=/prod-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 接口加密开关（后端 api-decrypt.enable=true，必须一致）
VITE_APP_ENCRYPT=true

# 客户端 id（与后端 sys_client 表保持一致）
VITE_APP_CLIENT_ID='e5cd7e4891bf95d1d19206ce24a7b32e'

# 以下 RSA 密钥是 RuoYi-Vue-Plus 上游公开的示例密钥（application.yml 内同一对）。
# R3：真实生产密钥不得提交到仓库，部署时用 `.env.production.local`（已 gitignore）或 CI 环境覆盖。
# 请求加密公钥：与后端 api-decrypt.privateKey 配对
VITE_APP_RSA_PUBLIC_KEY='MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
# 响应解密私钥：与后端 api-decrypt.publicKey 配对（不是上面公钥的配对私钥）
VITE_APP_RSA_PRIVATE_KEY=''
