# 端口号（T018；E2E baseURL 与之一致）
VITE_PORT=5666

VITE_BASE=/

# 接口地址：Vite 代理 /api → 后端 8080（见 vite.config.ts）
VITE_GLOB_API_URL=/api

# 后端 mock 应用已裁剪（T002），必须关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 接口加密开关（后端 api-decrypt.enable=true，必须一致；显式 false 才关闭）
VITE_APP_ENCRYPT=true

# 客户端 id（与后端 sys_client 表保持一致）
VITE_APP_CLIENT_ID='e5cd7e4891bf95d1d19206ce24a7b32e'

# 请求加密公钥：与后端 api-decrypt.privateKey 配对（见 application.yml）
VITE_APP_RSA_PUBLIC_KEY='MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
# 响应解密私钥：与后端 api-decrypt.publicKey 配对（不是上面公钥的配对私钥）
VITE_APP_RSA_PRIVATE_KEY=''
