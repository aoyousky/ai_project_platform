# 复制为 deploy/.env 后按需修改（.env 不入库）
#
# 镜像源：本机到 Docker Hub 不通，默认走 daocloud 公共代理。
# 能直连 Docker Hub 时改成 REGISTRY=docker.io/library
REGISTRY=docker.m.daocloud.io/library

MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=aoyou123

# 必填项，无默认值（红线 R3）。留空或未设置时 compose 会直接报错退出。
# 生成方式：export SA_TOKEN_JWT_SECRET=$(openssl rand -hex 32)
SA_TOKEN_JWT_SECRET=
