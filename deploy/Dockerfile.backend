ARG REGISTRY=docker.m.daocloud.io/library
FROM ${REGISTRY}/eclipse-temurin:17-jre

LABEL org.opencontainers.image.title="ai-work-platform-backend"
LABEL org.opencontainers.image.description="Aoyou 5.6.2 后端（由 deploy/prepare.sh 产出的 app.jar）"

ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-XX:MaxRAMPercentage=75"

WORKDIR /app
COPY build/app.jar /app/app.jar

EXPOSE 8080

# 用 sh -c 以便 JAVA_OPTS 展开；命令行追加参数会传入 $0..$* 之后
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar \"$@\"", "--"]
