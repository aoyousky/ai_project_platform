{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/commit-gate.sh\"",
            "timeout": 600,
            "statusMessage": "执行交付门禁（ci-gate）..."
          }
        ]
      }
    ]
  }
}
