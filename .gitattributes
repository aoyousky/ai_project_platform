# 统一行尾：仓库内一律 LF，避免 Windows 检出时被转成 CRLF
# （本机 core.autocrlf=true，若不固定，.sh 脚本检出后带 CRLF，在 Linux CI 上会报 bad interpreter）
* text=auto eol=lf

# 明确按文本处理并强制 LF
*.sh      text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf

# Windows 批处理保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制：不做任何换行转换，也不参与 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     text eol=lf
*.xdb     binary
*.jar     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
